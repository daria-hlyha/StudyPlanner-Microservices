# ==========================================================
# СТАДІЯ 1. СПІЛЬНЕ БАЗОВЕ СЕРЕДОВИЩЕ
# ==========================================================

FROM python:3.12-slim AS base

# Налаштування середовища Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Встановлення робочої директорії
WORKDIR /app

# Створення непривілейованого користувача
RUN groupadd --system appgroup \
    && useradd --system --gid appgroup --create-home appuser

# Копіювання файлу основних залежностей
COPY requirements.txt .

# Встановлення основних програмних залежностей
RUN pip install --no-cache-dir -r requirements.txt


# ==========================================================
# СТАДІЯ 2. ТЕСТОВЕ СЕРЕДОВИЩЕ
# ==========================================================

FROM base AS test

# Копіювання файлу тестових залежностей
COPY requirements-dev.txt .

# Встановлення додаткових тестових залежностей
RUN pip install --no-cache-dir -r requirements-dev.txt

# Копіювання програмного коду
COPY --chown=appuser:appgroup . .

# Запуск від непривілейованого користувача
USER appuser

# Команда запуску автоматизованих тестів
CMD ["python", "-m", "pytest"]


# ==========================================================
# СТАДІЯ 3. РОБОЧЕ СЕРЕДОВИЩЕ
# ==========================================================

FROM base AS runtime

# Копіювання програмного коду
COPY --chown=appuser:appgroup . .

# Запуск від непривілейованого користувача
USER appuser

# Внутрішній порт мікросервісу
EXPOSE 8000

# Запуск застосунку FastAPI
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
